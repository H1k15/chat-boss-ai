# ============ CHUNG ============
NODE_ENV=development

# ============ DATABASE ============
DATABASE_URL=postgresql://cba:cba@localhost:5432/chat_boss_ai?schema=public

# ============ REDIS (cache + BullMQ) ============
REDIS_URL=redis://localhost:6379

# ============ AUTH ============
JWT_ACCESS_SECRET=doi_secret_nay_o_production
JWT_REFRESH_SECRET=doi_secret_nay_o_production_2
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ============ AI PROVIDER ============
# claude | openai
AI_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-xxxxx
# Sonnet 5: cân bằng chi phí/chất lượng cho khối lượng hội thoại lớn.
# Cần chất lượng tư vấn cao hơn thì đổi sang claude-opus-4-8 (đắt hơn).
# LƯU Ý: các model đời này KHÔNG nhận tham số temperature/top_p (lỗi 400) —
# muốn chỉnh giọng văn thì sửa system prompt trong src/modules/ai/prompts.ts.
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL=gpt-4o-mini
# Chạy model mã nguồn mở trên máy (miễn phí, không cần key ngoài) qua Ollama:
#   AI_PROVIDER=openai
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_API_KEY=ollama          (giá trị bất kỳ khác rỗng)
#   OPENAI_MODEL=qwen2.5:3b
# Groq free (nhanh + chất lượng cao hơn nhiều local nhỏ), OpenAI-compatible:
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_API_KEY=gsk_...          (lấy free tại console.groq.com)
#   OPENAI_MODEL=openai/gpt-oss-20b
#   OPENAI_REASONING_EFFORT=low     (chỉ cho model reasoning; low = nhanh/rẻ token)
# OPENAI_BASE_URL để trống -> gọi server OpenAI thật.
OPENAI_BASE_URL=
# low|medium|high — chỉ gửi khi có đặt (model thường bỏ qua). Xem ghi chú trên.
OPENAI_REASONING_EFFORT=
# --- CHUỖI DỰ PHÒNG (fallback chain) ---
# Thêm tầng model, thử theo thứ tự khi tầng trên hết quota (429)/lỗi -> nhảy dưới.
# Tầng cloud thiếu key sẽ bị BỎ QUA (điền key sau là tự bật). Local không cần key.
# Mỗi tầng dùng bộ biến OPENAI_FBn_*  (n = 2..6). Ví dụ:
#   OPENAI_FB2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_FB2_API_KEY=            (Gemini free — aistudio.google.com)
#   OPENAI_FB2_MODEL=gemini-2.0-flash
#   OPENAI_FB3_BASE_URL=https://api.cerebras.ai/v1
#   OPENAI_FB3_API_KEY=           (Cerebras free — cloud.cerebras.ai)
#   OPENAI_FB3_MODEL=llama-3.3-70b
#   OPENAI_FB4_BASE_URL=http://localhost:11434/v1
#   OPENAI_FB4_API_KEY=ollama
#   OPENAI_FB4_MODEL=qwen3:4b
#   OPENAI_FB4_PROMPT_SUFFIX=/no_think   (tắt "suy nghĩ" của qwen3 cho nhanh)

# ============ TELEGRAM ============
TELEGRAM_BOT_TOKEN=123456:ABCDEF
TELEGRAM_DEFAULT_CHAT_ID=-1001234567890

# ============ GOOGLE SHEETS (tuỳ chọn — cho POST /sheets/sync) ============
# Đường dẫn file key service account, HOẶC dán thẳng nội dung JSON.
# Cách lấy: Google Cloud Console -> tạo project -> bật Google Sheets API ->
# tạo Service Account -> tạo key JSON -> chia sẻ Sheet cho email service account.
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/gsheet-service-account.json
# Tự động đồng bộ sheet mỗi N phút (dùng cấu hình đã lưu). Đặt 0 để TẮT.
SHEET_SYNC_INTERVAL_MINUTES=240
# AI hỗ trợ dò loại phòng cho ca keyword bỏ sót (gõ tắt/sai chính tả). Gọi LLM
# 1 lần/lô, ép chọn trong danh sách loại đã biết. MẶC ĐỊNH TẮT vì model local
# nhỏ (3B) hay bịa loại + chạy chậm. Chỉ bật (=true) khi AI_PROVIDER=claude.
# (Dò loại chính đã dùng keyword + so khớp mờ fuzzy — code thuần, không cần AI.)
SHEET_AI_ROOMTYPE=false
# Ghi nhãn (mô tả phòng -> loại) vào exports/room-type-dataset.jsonl mỗi lần
# đồng bộ, để tích luỹ dữ liệu train về sau. Đặt false để tắt.
SHEET_ROOMTYPE_DATASET=true
# Câu AI báo khi khách hỏi ảnh/video mà phòng CHƯA có link nào (thực tế + demo).
# MEDIA_UNAVAILABLE_MSG="Phòng này bên em chưa có sẵn ảnh ạ, anh/chị để lại SĐT em gửi sau nhé!"

# ============ STORAGE (S3/MinIO) ============
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=chat-boss-media
S3_REGION=us-east-1

# ============ APP URLS ============
BACKEND_PORT=3001
BACKEND_PUBLIC_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:3000
