# ============ CHUNG ============
NODE_ENV=development

# ============ DATABASE ============
DATABASE_URL=postgresql://cba:cba@localhost:5432/chat_boss_ai?schema=public

# ============ REDIS (cache + BullMQ) ============
REDIS_URL=redis://localhost:6379

# ============ AUTH ============
JWT_ACCESS_SECRET=doi_secret_nay_o_production
JWT_REFRESH_SECRET=doi_secret_nay_o_production_2
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ============ AI PROVIDER ============
# claude | openai
AI_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-xxxxx
# Sonnet 5: cân bằng chi phí/chất lượng cho khối lượng hội thoại lớn.
# Cần chất lượng tư vấn cao hơn thì đổi sang claude-opus-4-8 (đắt hơn).
# LƯU Ý: các model đời này KHÔNG nhận tham số temperature/top_p (lỗi 400) —
# muốn chỉnh giọng văn thì sửa system prompt trong src/modules/ai/prompts.ts.
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL=gpt-4o-mini

# ============ TELEGRAM ============
TELEGRAM_BOT_TOKEN=123456:ABCDEF
TELEGRAM_DEFAULT_CHAT_ID=-1001234567890

# ============ GOOGLE SHEETS (tuỳ chọn) ============
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/gsheet-service-account.json

# ============ STORAGE (S3/MinIO) ============
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=chat-boss-media
S3_REGION=us-east-1

# ============ APP URLS ============
BACKEND_PORT=3001
BACKEND_PUBLIC_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:3000
