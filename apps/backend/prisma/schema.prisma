// Prisma schema — Chat Boss AI
// Tiền tệ lưu bằng Int (VND) để tránh sai số dấu phẩy động.
//
// MULTI-TENANCY (Đợt 1 — nền dữ liệu): mọi bảng nghiệp vụ có organizationId trỏ
// về Organization. Tạm để @default("org_seed_default") để hệ đang chạy không gãy
// khi tạo bản ghi mới (code chưa gắn org). ĐỢT 2 sẽ BỎ default và tự set org theo
// tenant context (JWT) qua Prisma extension. geocode_cache (trong app_settings)
// giữ toàn cục, KHÔNG gắn org — xử lý ở Đợt 3.

generator client {
  provider = "prisma-client-js"
  // "native" cho máy dev. Bản musl phải chỉ đích danh openssl-3.0.x: image
  // node:20-alpine dùng OpenSSL 3, còn target "linux-musl" trơn lại link vào
  // libssl.so.1.1 nên container chết ngay lúc khởi tạo PrismaClient.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================ ENUMS ============================

enum UserRole {
  SUPER_ADMIN // chủ SaaS — quản lý mọi org (Đợt 4). Không thuộc org cụ thể.
  ADMIN
  MANAGER
  STAFF
}

enum CustomerStatus {
  NEW
  ASKING_INFO
  ADVISED
  SENT_MEDIA
  ASKED_PHONE
  HAS_PHONE
  APPOINTED
  VIEWED
  CONSIDERING
  CLOSED
  NOT_SUITABLE
  NO_RESPONSE
}

enum Channel {
  INBOX
  COMMENT
}

enum CustomerIntent {
  ASK_AVAILABILITY
  ASK_PRICE
  ASK_ADDRESS
  ASK_UTILITIES
  ASK_MEDIA
  LEFT_PHONE
  WANT_VIEWING
  GREETING
  SMALL_TALK
  IRRELEVANT
  OTHER
}

enum RoomStatus {
  AVAILABLE
  DEPOSITED
  RENTED
  UNAVAILABLE
}

enum AppointmentStatus {
  SCHEDULED
  ARRIVED
  CANCELLED
  NO_SHOW
}

enum CareTaskStatus {
  PENDING
  DONE
  SNOOZED
  CANCELLED
}

enum NotifyEvent {
  LEFT_PHONE
  APPOINTMENT
  URGENT_CALL
  EOD_REPORT
  ROOM_LOW
  CARE_REMINDER
}

// ============================ MODELS ============================

// Mỗi chủ trọ = một Organization. Dữ liệu tách biệt theo organizationId.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("default")
  isActive  Boolean  @default(true)
  // Hạn dùng dịch vụ. null = không giới hạn (org nội bộ/chủ). Quá hạn -> backend
  // chặn các endpoint giá trị (SubscriptionGuard). Gia hạn bằng key hoặc super-admin.
  subscriptionExpiresAt DateTime?
  note      String? // ghi chú quản trị về nhà trọ
  archivedAt DateTime? // lưu trữ (ẩn khỏi danh sách chính); dọn/purge sau
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  facebookProfiles      FacebookProfile[]
  customers             Customer[]
  customerNotes         CustomerNote[]
  conversations         Conversation[]
  messages              Message[]
  rooms                 Room[]
  appointments          Appointment[]
  careTasks             CareTask[]
  telegramNotifications TelegramNotification[]
  activityLogs          ActivityLog[]
  replyTemplates        ReplyTemplate[]
  importBatches         ImportBatch[]
  appSettings           AppSetting[]

  @@map("organizations")
}

model User {
  id           String   @id @default(cuid())
  email        String
  passwordHash String
  fullName     String
  phone        String?
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  mustChangePassword Boolean @default(false) // buộc đổi mật khẩu lần đăng nhập đầu
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizationId String       @default("org_seed_default")
  organization   Organization @relation(fields: [organizationId], references: [id])

  facebookProfiles  FacebookProfile[]
  assignedCustomers Customer[]        @relation("AssignedStaff")
  appointments      Appointment[]     @relation("StaffAppointments")
  careTasks         CareTask[]
  activityLogs      ActivityLog[]

  @@unique([organizationId, email]) // email duy nhất TRONG một org
  @@index([organizationId])
  @@map("users")
}

model FacebookProfile {
  id             String   @id @default(cuid())
  displayName    String // Tên hiển thị nick (Nick A, Nick B...)
  browserProfile String? // Tên profile trình duyệt đang dùng
  area           String? // Khu vực phụ trách
  isActive       Boolean  @default(true)
  ownerId        String
  owner          User     @relation(fields: [ownerId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String       @default("org_seed_default")
  organization   Organization @relation(fields: [organizationId], references: [id])

  customers     Customer[]
  conversations Conversation[]

  @@index([ownerId])
  @@index([organizationId])
  @@map("facebook_profiles")
}

model Customer {
  id           String         @id @default(cuid())
  name         String?
  phone        String?        @db.VarChar(20)
  facebookName String?
  sourceType   Channel        @default(INBOX)
  areaNeed     String?
  budgetMin    Int? // VND
  budgetMax    Int? // VND
  moveInDate   DateTime?
  peopleCount  Int?
  requirements String[]       @default([])
  status       CustomerStatus @default(NEW)

  sourceProfileId String?
  sourceProfile   FacebookProfile? @relation(fields: [sourceProfileId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("AssignedStaff", fields: [assignedToId], references: [id])

  organizationId String       @default("org_seed_default")
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
  appointments  Appointment[]
  careTasks     CareTask[]
  notes         CustomerNote[]

  @@index([status])
  @@index([assignedToId])
  @@index([phone])
  @@index([organizationId])
  @@map("customers")
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String?
  content    String
  createdAt  DateTime @default(now())

  organizationId String       @default("org_seed_default")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([customerId])
  @@index([organizationId])
  @@map("customer_notes")
}

model Conversation {
  id                String           @id @default(cuid())
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  facebookProfileId String?
  facebookProfile   FacebookProfile? @relation(fields: [facebookProfileId], references: [id])
  channel           Channel          @default(INBOX)
  lastMessage       String?
  intent            CustomerIntent?
  status            String           @default("open")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organizationId String       @default("org_seed_default")
  organization   Organization @relation(fields: [organizationId], references: [id])

  messages Message[]

  @@index([customerId])
  @@index([organizationId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "customer" | "staff" | "ai_suggestion"
  text           String
  createdAt      DateTime     @default(now())

  organizationId String       @default("org_seed_default")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([conversationId])
  @@index([organizationId])
  @@map("messages")
}

model Room {
  id               String     @id @default(cuid())
  roomCode         String
  code             String? // mã ngắn tự cấp (R001, R002...), giữ nguyên qua các lần đồng bộ
  roomNumber       String? // số phòng nguyên văn từ sheet (VD "501")
  stayDuration     String? // thời gian ở (nguyên văn cột "Thời gian ở")
  salePrice        Int? // giá sale/khuyến mãi (VND), null nếu không có
  area             String
  address          String?
  price            Int // VND
  deposit          Int? // VND
  size             Int? // m2
  peopleCountMin   Int?
  peopleCountMax   Int?
  roomType         String? // gác, studio, phòng thường
  wc               String? // "rieng" | "chung"
  utilities        String[]   @default([]) // ["may_lanh","tu_lanh","nem"]
  electricityPrice Int?
  waterPrice       Int?
  freeHours        Boolean    @default(true) // giờ giấc tự do
  parking          Boolean    @default(false)
  petAllowed       Boolean    @default(false)
  status           RoomStatus @default(AVAILABLE)
  imageLinks       String[]   @default([])
  videoLinks       String[]   @default([])
  managerName      String?
  note             String?
  furniture        String? // nội thất nguyên văn (cho AI đọc, không tách cột)

  // Toạ độ đã geocode (OpenStreetMap Nominatim) — để lọc phòng theo bán kính
  // bằng Haversine. Có toạ độ rồi thì KHÔNG gọi lại API. Nguồn 'manual' = nhân
  // viên ghim tay (ưu tiên hơn geocode tự động).
  latitude        Float?
  longitude       Float?
  geocodedAddress String? // display_name Nominatim trả về
  geocodedAt      DateTime?
  geocodeSource   String? // "nominatim" | "manual"

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  organizationId String       @default("org_seed_default")
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@unique([organizationId, roomCode]) // mã phòng duy nhất TRONG một org
  @@unique([organizationId, code])
  @@index([area])
  @@index([status])
  @@index([price])
  @@index([organizationId])
  @@map("rooms")
}

model Appointment {
  id                 String            @id @default(cuid())
  customerId         String
  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  roomId             String?
  room               Room?             @relation(fields: [roomId], references: [id])
  appointmentTime    DateTime
  appointmentAddress String?
  staffId            String?
  staff              User?             @relation("StaffAppointments", fields: [staffId], references: [id])
  status             AppointmentStatus @default(SCHEDULED)
  note               String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organizationId String       @default("org_seed_default")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([appointmentTime])
  @@index([staffId])
  @@index([organizationId])
  @@map("appointments")
}

model CareTask {
  id           String         @id @default(cuid())
  customerId   String
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?          @relation(fields: [assignedToId], references: [id])
  dueAt        DateTime
  reason       String? // vì sao cần chăm (chưa phản hồi, đã xem ảnh...)
  status       CareTaskStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  organizationId String       @default("org_seed_default")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([dueAt])
  @@index([status])
  @@index([organizationId])
  @@map("care_tasks")
}

model TelegramNotification {
  id        String      @id @default(cuid())
  event     NotifyEvent
  payload   Json
  chatId    String
  sentAt    DateTime?
  success   Boolean     @default(false)
  error     String?
  dedupeKey String? // chống gửi trùng
  createdAt DateTime    @default(now())

  organizationId String       @default("org_seed_default")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, dedupeKey]) // dedupe trong phạm vi org
  @@index([event])
  @@index([organizationId])
  @@map("telegram_notifications")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // "AI_SUGGEST", "SAFETY_BLOCK", "SEND_SEMI_AUTO", "EXPORT"...
  entity    String? // "customer:123"
  meta      Json?
  createdAt DateTime @default(now())

  organizationId String       @default("org_seed_default")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([organizationId])
  @@map("activity_logs")
}

model ReplyTemplate {
  id        String   @id @default(cuid())
  intent    String // CustomerIntent hoặc CustomerStatus (kịch bản chăm sóc)
  label     String
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String       @default("org_seed_default")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("reply_templates")
}

model ImportBatch {
  id        String   @id @default(cuid())
  source    String // "excel" | "google_sheet"
  fileName  String?
  created   Int      @default(0)
  updated   Int      @default(0)
  errors    Json?
  createdBy String?
  createdAt DateTime @default(now())

  organizationId String       @default("org_seed_default")
  organization   Organization @relation(fields: [organizationId], references: [id])

  rooms Room[]

  @@index([organizationId])
  @@map("import_batches")
}

// Cấu hình chạy runtime dạng key-value (admin sửa qua API, không phải deploy
// lại). Ví dụ: cấu hình Telegram (chat mặc định, bật/tắt sự kiện). KHÔNG lưu
// secret ở đây (bot token vẫn ở .env) — bảng này có thể lộ qua API cấu hình.
// Multi-tenant Đợt 3: cấu hình runtime TÁCH THEO ORG (khoá kép organizationId+key).
// Kể cả geocode_cache cũng per-org (đồng nhất; chấp nhận geocode lại giữa các org).
// Key kích hoạt/gia hạn dịch vụ (bán trả trước). KHÔNG lưu key thô — chỉ hash.
// Bảng TOÀN CỤC (super-admin sinh, org nào cũng có thể kích hoạt) -> không gắn org
// scope; org kích hoạt lưu ở activatedByOrg.
model LicenseKey {
  id             String    @id @default(cuid())
  keyHash        String    @unique // sha256(key) — tra bằng hash, không lộ key
  keyPrefix      String // vài ký tự đầu để hiển thị/nhận diện
  durationDays   Int // số ngày cộng vào hạn khi kích hoạt
  plan           String? // gói áp dụng khi kích hoạt (tuỳ chọn)
  note           String?
  activatedAt    DateTime?
  activatedByOrg String? // id org đã kích hoạt
  createdAt      DateTime  @default(now())

  @@index([activatedByOrg])
  @@map("license_keys")
}

// Idempotency cho batch apply-changes: lưu kết quả theo requestId để không xử lý
// hai lần (double-submit / retry). Bảng toàn cục.
model AdminBatchRequest {
  requestId String   @id
  result    Json
  createdAt DateTime @default(now())

  @@map("admin_batch_requests")
}

// Phiên đăng nhập (thiết bị) — cho giới hạn số ghế/thiết bị theo gói (maxSeats).
// Mỗi refresh token = một phiên; thu hồi (revokedAt) khi vượt ghế hoặc đăng xuất.
model UserSession {
  id               String    @id @default(cuid())
  userId           String
  organizationId   String
  refreshTokenHash String    @unique // sha256(refreshToken)
  userAgent        String?
  ip               String?
  lastSeenAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?

  @@index([organizationId])
  @@index([userId])
  @@map("user_sessions")
}

model AppSetting {
  organizationId String       @default("org_seed_default")
  organization   Organization @relation(fields: [organizationId], references: [id])
  key            String
  value          Json
  updatedAt      DateTime     @updatedAt

  @@id([organizationId, key])
  @@map("app_settings")
}
