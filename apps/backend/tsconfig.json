{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "moduleResolution": "node",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "outDir": "./dist",
    // Không map @cba/shared qua "paths": làm vậy kéo source của package vào
    // chương trình, tsc suy rootDir thành gốc monorepo và dist bị lồng thêm
    // tầng. Để Node resolve qua node_modules về bản đã build của shared.
    "rootDir": "./"
  },
  "include": ["src", "prisma"],
  "exclude": ["node_modules", "dist"]
}
