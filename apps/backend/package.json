{
  "name": "@cba/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/src/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "seed": "dotenv -e ../../.env -- ts-node prisma/seed.ts",
    "seed:templates": "dotenv -e ../../.env -- ts-node prisma/seed-templates.ts",
    "export:finetune": "dotenv -e ../../.env -- ts-node prisma/export-finetune.ts",
    "analyze:logs": "dotenv -e ../../.env -- ts-node prisma/analyze-logs.ts",
    "verify:tenant": "dotenv -e ../../.env -- ts-node prisma/verify-tenant-isolation.ts",
    "import:fb": "dotenv -e ../../.env -- ts-node prisma/import-fb-history.ts",
    "prisma": "dotenv -e ../../.env -- prisma"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "@cba/shared": "workspace:*",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.3.0",
    "@nestjs/websockets": "^10.3.0",
    "@prisma/client": "^5.18.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "googleapis": "^140.0.0",
    "ioredis": "^5.4.1",
    "nestjs-pino": "^4.1.0",
    "node-telegram-bot-api": "^0.66.0",
    "openai": "^4.56.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "@types/node-telegram-bot-api": "^0.64.7",
    "@types/passport-jwt": "^4.0.1",
    "dotenv-cli": "^7.4.2",
    "jest": "^29.7.0",
    "prisma": "^5.18.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
