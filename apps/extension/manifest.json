{
  "manifest_version": 3,
  "name": "Chat Boss AI - Trợ lý tư vấn phòng trọ",
  "version": "0.1.0",
  "description": "Hỗ trợ nhân viên tư vấn khách thuê phòng trên Facebook/Messenger. AI gợi ý trả lời, không tự spam.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.messenger.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*", "https://*.messenger.com/*"],
      "js": ["content.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chat Boss AI"
  }
}
